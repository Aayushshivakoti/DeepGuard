# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Deepfake & Phishing Media Verification Gateway"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_SECRET=CHANGE_ME_SECRET

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/deepguard_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/deepguard_db

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=defaultpass
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,audio/wav,audio/mpeg,audio/mp4,video/mp4,video/quicktime,application/pdf

# ─── AI Model Settings ───────────────────────────────────────────────────────
MODEL_DEVICE=cpu
# Set to "cuda" if NVIDIA GPU available; "mps" for Apple Silicon
SPATIAL_MODEL_PATH=weights/efficientnet_b4_deepfake.pt
AUDIO_MODEL_PATH=weights/voice_clone_detector.pt
USE_MOCK_MODELS=true
# Set USE_MOCK_MODELS=false only when real weight files are present

# ─── Third-Party API Keys ─────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
GOOGLE_SAFE_BROWSING_KEY=your-google-safe-browsing-key-here

# ─── OAuth & WebAuthn SSO Settings ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
WEBAUTHN_RP_ID=deepguard.com
WEBAUTHN_RP_NAME="DeepGuard Gateway"
WEBAUTHN_ORIGIN=https://deepguard.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://localhost:4173
