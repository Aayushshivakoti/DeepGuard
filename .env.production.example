# DeepGuard - Production Environment Configuration Template
# Duplicate this file as .env.production and supply real secrets before deployment.

# ─── Server Configuration ─────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=generate-a-secure-random-long-key-using-openssl-rand-hex-32
JWT_SECRET=generate-a-secure-jwt-signing-key-using-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database Connections ──────────────────────────────────────────────────────
# Production PostgreSQL AsyncPG and Sync connection URIs
DATABASE_URL=postgresql+asyncpg://db_user:db_password@postgres_host:5432/deepguard_db
SYNC_DATABASE_URL=postgresql://db_user:db_password@postgres_host:5432/deepguard_db

# ─── Redis & Celery background workers ──────────────────────────────────────────
REDIS_URL=redis://:redis_password@redis_host:6379/0

# ─── Deep Learning Model Configs ───────────────────────────────────────────────
# Keep fallback models disabled to run production-grade neural networks
USE_MOCK_MODELS=false
SPATIAL_MODEL_PATH=weights/efficientnet_b4_deepfake.pt
MODEL_DEVICE=cpu

# ─── Cloud Storage & Augmentation Datasets ────────────────────────────────────
AWS_ACCESS_KEY_ID=aws-access-key-id-placeholder
AWS_SECRET_ACCESS_KEY=aws-secret-access-key-placeholder
AWS_REGION=us-east-1
AUG_DATASET_BUCKET=deepguard-augmentation-datasets
HARD_NEGATIVES_PREFIX=mined-negatives/
